# MSFragger 4.2 - FROZEN params for the A549 TMT whole-proteome search (UC-A).
#
# WHY. calibrate_mass = 2 re-derives search parameters from a first-pass search against WHICHEVER
# database it is given. Measured on A549 (12 mzML, all fractions, 2026-08-04):
#
#   DB          intensity_transform   remove_precursor_peak   score cutoff @1% FDR
#   canonical   1                     0                       19.354
#   model       0                     1                       18.061   <-- DIVERGES from baseline
#   null        0                     1                       18.347   <-- DIVERGES from baseline
#
# Here the CANONICAL baseline is the odd one out, so the dPSM reference itself was not comparable to
# the arms measured against it. The 2.00x / 2.31x model-vs-null ratios must be re-run frozen.
#
# Frozen to the CANONICAL database's optimizer output.
#   fragment_mass_tolerance  0.6 Da -> 150 ppm  (150 ppm is ~0.15 Da at m/z 1000, so 0.6 Da was ~4x
#                                                too wide; this is low-res ion-trap MS2)
#   use_topN_peaks              150 -> 100
#   max_fragment_charge           3 -> 1
#   remove_precursor_peak         1 -> 0
#   calibrate_mass                2 -> 0
#
# Re-derive if the instrument or study changes: run one arm at calibrate_mass = 2 and read the
# "New <param> = ..." lines from the MSFragger log.

database_name = /private/groups/carpenterlab/emalekos/RNAZoo_meta/RNAZoo/experiments/biotype_probe/expression_context_human/data/msfragger/gencode_v49_plus_fporf_negctrl_rxgbext_combined.fasta
num_threads = 0

# precursor / fragment tolerances (Orbitrap HCD typical)
precursor_mass_lower = -20
precursor_mass_upper = 20
precursor_mass_units = 1
data_type = 0
precursor_true_tolerance = 20
precursor_true_units = 1
fragment_mass_tolerance = 150
fragment_mass_units = 1
calibrate_mass = 0
use_all_mods_in_first_search = 0
decoy_prefix = REV_

deisotope = 1
deneutralloss = 1
isotope_error = 0/1/2
mass_offsets = 0.0
precursor_mass_mode = selected

remove_precursor_peak = 0
remove_precursor_range = -1.500000,1.500000
intensity_transform = 1
activation_types = all
analyzer_types = all
group_variable = 0
require_precursor = 0
reuse_dia_fragment_peaks = 0

write_calibrated_mzml = 0
write_uncalibrated_mzml = 0
write_mzbin_all = 0
mass_diff_to_variable_mod = 0

localize_delta_mass = 0
delta_mass_exclude_ranges = (-1.5,3.5)
fragment_ion_series = b,y
ion_series_definitions =

labile_search_mode = off
restrict_deltamass_to = all
diagnostic_intensity_filter = 0
Y_type_masses =
diagnostic_fragments =
remainder_fragment_masses =

# Trypsin (K|R, not before P), fully tryptic, up to 1 missed cleavage
search_enzyme_name_1 = trypsin
search_enzyme_cut_1 = KR
search_enzyme_nocut_1 = P
search_enzyme_sense_1 = C
allowed_missed_cleavage_1 = 1

search_enzyme_name_2 = null
search_enzyme_cut_2 =
search_enzyme_nocut_2 =
search_enzyme_sense_2 = C
allowed_missed_cleavage_2 = 2

num_enzyme_termini = 2

clip_nTerm_M = 0

# Variable mods (mirroring comet.params variable_mod01/02)
variable_mod_01 = 15.9949 M 3
variable_mod_02 = 42.0106 [^ 1

allow_multiple_variable_mods_on_residue = 0
max_variable_mods_per_peptide = 3
max_variable_mods_combinations = 5000

# Emit pepXML + tsv + pin so downstream parser has options
output_format = tsv_pepxml_pin
output_report_topN = 5
output_max_expect = 50
report_alternative_proteins = 1

precursor_charge = 1 6
override_charge = 0

digest_min_length = 6
digest_max_length = 50
digest_mass_range = 500.0 5000.0
max_fragment_charge = 1

track_zero_topN = 0
zero_bin_accept_expect = 0
zero_bin_mult_expect = 1

check_spectral_files = 1
minimum_peaks = 15
use_topN_peaks = 100
min_fragments_modelling = 2
min_matched_fragments = 4
min_sequence_matches = 2
minimum_ratio = 0.01
clear_mz_range = 0.0 0.0

add_Cterm_peptide = 0.0
add_Nterm_peptide = 229.162932
add_Cterm_protein = 0.0
add_Nterm_protein = 0.0

add_G_glycine = 0.0
add_A_alanine = 0.0
add_S_serine = 0.0
add_P_proline = 0.0
add_V_valine = 0.0
add_T_threonine = 0.0
add_C_cysteine = 57.021464
add_L_leucine = 0.0
add_I_isoleucine = 0.0
add_N_asparagine = 0.0
add_D_aspartic_acid = 0.0
add_Q_glutamine = 0.0
add_K_lysine = 229.162932
add_E_glutamic_acid = 0.0
add_M_methionine = 0.0
add_H_histidine = 0.0
add_F_phenylalanine = 0.0
add_R_arginine = 0.0
add_Y_tyrosine = 0.0
add_W_tryptophan = 0.0
add_B_user_amino_acid = 0.0
add_J_user_amino_acid = 0.0
add_O_user_amino_acid = 0.0
add_U_user_amino_acid = 0.0
add_X_user_amino_acid = 0.0
add_Z_user_amino_acid = 0.0
