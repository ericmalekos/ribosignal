FROM nvidia/cuda:11.8.0-cudnn8-devel-ubuntu22.04

LABEL org.opencontainers.image.title="riboseq-model"
LABEL org.opencontainers.image.description="Single environment for the ENTIRE riboseq_signal_model chain: STAR/salmon/samtools/cutadapt/gffread, RiboCode + Ribo-TISH + ribotricer, pack build, train, predict, eval, for BOTH transformer and mamba mixers."

# See containers/riboseq-model.def for the full rationale. Summary: the four environments this
# replaces each had a disqualifying gap (no torch / no h5py / no mamba_ssm / no pysam), which caused
# scripts to die on import. Pins are a UNIT -- python3.10 + torch 2.2.0+cu118 + the two PREBUILT
# mamba wheels below, whose ABI tag matches that exact combination.

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        git wget ca-certificates build-essential \
        zlib1g-dev libbz2-dev liblzma-dev libcurl4-openssl-dev libssl-dev && \
    rm -rf /var/lib/apt/lists/*

RUN wget -q https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh -O /tmp/mf.sh && \
    bash /tmp/mf.sh -b -p /opt/conda && rm /tmp/mf.sh
ENV PATH="/opt/conda/bin:$PATH"

RUN mamba create -n rsm -c conda-forge -y python=3.10 "numpy<2" "setuptools<70" pip cython && \
    mamba clean -afy

# torch FIRST -- the mamba wheels are built against this exact version
RUN /opt/conda/envs/rsm/bin/pip install --no-cache-dir \
        torch==2.2.0 --index-url https://download.pytorch.org/whl/cu118

# PREBUILT mamba kernels (never from source: source builds are the usual "undefined symbol" cause)
RUN /opt/conda/envs/rsm/bin/pip install --no-cache-dir \
        "https://github.com/Dao-AILab/causal-conv1d/releases/download/v1.2.0.post2/causal_conv1d-1.2.0.post2+cu118torch2.2cxx11abiFALSE-cp310-cp310-linux_x86_64.whl" \
        "https://github.com/state-spaces/mamba/releases/download/v1.2.0.post1/mamba_ssm-1.2.0.post1+cu118torch2.2cxx11abiFALSE-cp310-cp310-linux_x86_64.whl"

# transformers<4.45 and huggingface_hub<0.25 are NOT optional. `import mamba_ssm` executes
# mamba_ssm/__init__.py -> MambaLMHeadModel -> utils.generation, which does
#   from transformers.generation import GreedySearchDecoderOnlyOutput
# a symbol removed in transformers 4.45. Without the pin the image builds and then dies on the
# very first `import mamba_ssm`. Same pins as the working Dockerfile.Orthrus.
RUN /opt/conda/envs/rsm/bin/pip install --no-cache-dir \
        "transformers<4.45" "huggingface_hub<0.25" "triton" "packaging" \
        "scipy==1.15.3" "pandas==2.3.3" "h5py==3.16.0" "pysam==0.22.1" \
        "scikit-learn==1.5.2" "matplotlib==3.9.2" "einops==0.8.2" "pyfaidx==0.8.1.3"

# Alignment / quant / BAM tools, pinned to what conda_envs/riboseq runs today so a container run and
# a legacy conda run produce identical output. bioconda channel order matters: bioconda first, then
# conda-forge, or salmon resolves against the wrong libstdc++.
RUN mamba install -n rsm -y -c bioconda -c conda-forge \
        star=2.7.11b \
        salmon=2.1.2 \
        samtools=1.23.1 \
        cutadapt=5.2 \
        gffread=0.12.7 \
        ribotricer=1.5.0 \
    && mamba clean -afy

# RiboCode: imported directly by scripts/ribocode_dropin.py and the ORF-call chain. pip, not conda --
# the conda build drags an older pysam that would downgrade the one pinned above.
RUN /opt/conda/envs/rsm/bin/pip install --no-cache-dir --no-deps "ribocode==1.2.15"

# Ribo-TISH: the second ORF caller the README documents. Pure python, and it needs no bam because
# `predict --inprofile` takes a per-transcript P-site profile directly.
#
# RiboTaper is the one documented caller NOT in this image, on purpose: it pins python 2.7 so it
# cannot share this env, its bundled R 3.4.1 needs a hand-installed libgfortran.so.3, and it is
# GPL-3, which is a redistribution obligation this image should not carry. Install it separately
# if you need it.
RUN /opt/conda/envs/rsm/bin/pip install --no-cache-dir "ribotish==0.2.8"

# fail the BUILD, not a job three hours in
RUN /opt/conda/envs/rsm/bin/python -c "\
import torch, numpy, scipy, pandas, h5py, pysam, sklearn, matplotlib, einops; \
import mamba_ssm, causal_conv1d, RiboCode; \
from mamba_ssm.ops.selective_scan_interface import selective_scan_ref, mamba_inner_ref; \
from causal_conv1d.causal_conv1d_interface import causal_conv1d_ref; \
print('py deps OK', torch.__version__, torch.version.cuda, numpy.__version__)" && \
    for t in STAR salmon samtools cutadapt gffread ribotish ribotricer; do \
        /opt/conda/envs/rsm/bin/$t --version >/dev/null 2>&1 || { echo "MISSING $t" >&2; exit 1; }; \
    done && echo "tools OK"

ENV PATH="/opt/conda/envs/rsm/bin:$PATH"
ENV PYTHONNOUSERSITE=1


# ---------------------------------------------------------------------------------------------
# Bake the released weights in, so the image needs no runtime download and no network.
#
# emalek/RiboSignal is PUBLIC, so this fetches anonymously and needs no credentials. The token
# path is kept for anyone forking with private weights.
#
# It arrives as a BUILD SECRET, not a build ARG. A build arg is recorded in the image metadata
# and any puller can read it back with `docker history`, so the one case the argument exists to
# serve -- a fork with private weights -- was the case that leaked the credential. A secret mount
# is visible only to this RUN and never lands in a layer. Supply it with
#   docker build --secret id=hf_token,env=HF_TOKEN ...
# and it is simply absent, and the fetch anonymous, when nobody passes one.
#
# Keeping the repository public is what makes this image buildable on a GitHub-hosted runner at
# all. This project already hit the opposite case with HydraRNA, whose Google-Drive-only weights
# made its image unbuildable in CI, and mirroring to Hugging Face is what fixed it.
ARG HF_REPO="emalek/RiboSignal"
ARG HF_REVISION="main"
ENV RIBO_WEIGHTS=/opt/riboseq-model/weights

RUN --mount=type=cache,target=/root/.cache/huggingface \
    --mount=type=secret,id=hf_token \
    HF_REPO="$HF_REPO" HF_REVISION="$HF_REVISION" \
    /opt/conda/envs/rsm/bin/python -c "\
import os, pathlib; from huggingface_hub import snapshot_download; \
t = pathlib.Path('/run/secrets/hf_token'); \
snapshot_download(os.environ['HF_REPO'], revision=os.environ['HF_REVISION'], \
                  local_dir=os.environ['RIBO_WEIGHTS'], \
                  token=((t.read_text().strip() or None) if t.is_file() else None), \
                  allow_patterns=['*.pt','*_config.json','*_test_metrics.json','model.py', \
                                  'LICENSE','SHA256SUMS'])" \
    && rm -rf "$RIBO_WEIGHTS/.cache"

# fail the BUILD if the weights did not land or do not load
RUN /opt/conda/envs/rsm/bin/python -c "\
import os, torch, pathlib; \
w = pathlib.Path(os.environ['RIBO_WEIGHTS']); \
missing = [n for n in ('attn_best.pt','mamba4_best.pt') if not (w/n).is_file()]; \
assert not missing, f'weights missing from image: {missing}'; \
[print(n, f'{sum(v.numel() for v in torch.load(w/n, map_location=\"cpu\", weights_only=True).values()):,} params') \
 for n in ('attn_best.pt','mamba4_best.pt')]"

LABEL org.opencontainers.image.source="https://github.com/ericmalekos/ribosignal"
# No licenses= label: the repository states no licence (README, "License"). The MIT on the
# Hugging Face model card covers the WEIGHTS, and this image contains both, so claiming MIT
# here would assert a licence over the code that its owner has not granted.

# Ship the pipeline itself, so the image runs without bind-mounting a checkout. LAST on purpose:
# editing a script must not invalidate the torch, mamba-wheel or weight-download layers above.
COPY scripts/ /opt/riboseq-model/scripts/
ENV RIBO_SCRIPTS=/opt/riboseq-model/scripts
ENV PYTHONPATH=/opt/riboseq-model/scripts
