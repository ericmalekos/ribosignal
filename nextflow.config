// ribosignal: per-nucleotide Ribo-seq P-site prediction, and ORF calls from the prediction.
//
// The pipeline mirrors scripts/demo/run_demo.sh step for step. That script stays the
// reference implementation; this exists so the same run is reproducible on a scheduler
// without hand-managing intermediates.

manifest {
    name            = 'ribosignal'
    author          = 'Eric Malekos'
    homePage        = 'https://github.com/ericmalekos/ribosignal'
    description     = 'Predict per-nucleotide Ribo-seq P-site profiles from RNA-seq, and call ORFs from the prediction'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '0.1.0'
}

params {
    // --- inputs: bring FASTQ, or bring transcriptome BAMs and skip alignment ---
    help            = false
    rna_fastq       = null      // glob for paired RNA-seq, e.g. 'fastq/SRR*_{1,2}.fastq.gz'
    ribo_fastq      = null      // single-end Ribo-seq footprints
    rna_bam         = null      // STAR Aligned.toTranscriptome.out.bam, skips RNA alignment
    ribo_bam        = null      // ditto for Ribo-seq

    // --- reference ---
    gtf             = null      // supply both, or leave null and set gencode_release
    fasta           = null
    gencode_release = 49
    chrom           = 'chr22'   // 'all' for the primary assembly; needs ~32 GB to index
    star_index      = null      // reuse an index instead of building one

    // --- adapter: null MEASURES it, '' asserts already-trimmed, a string forces it ---
    ribo_adapter    = null

    // --- model ---
    arch            = 'attn,mamba4'
    weights         = 'emalek/RiboSignal'   // HF repo id, or a local directory
    device          = 'cpu'                 // the gpu profile sets this to cuda

    // --- ORF calling ---
    min_aa          = 30
    pval            = 0.05
    pred_scale      = 0.05      // Poisson dial; the second calling arm
    skip_ribotish   = false

    // --- limits and output ---
    max_tx_length   = 10000     // the released checkpoints never saw a longer transcript
    outdir          = 'results'
    publish_mode    = 'copy'
}

process {
    errorStrategy = 'terminate'
    cpus          = 4
    memory        = 16.GB
    time          = 4.h

    withLabel: big_mem   { cpus = 16; memory = 64.GB; time = 12.h }
    withLabel: alignment { cpus = 16; memory = 64.GB; time = 12.h }
    // mamba4 on CPU is 6.3x attn (3 h 10 m vs 30 m on chr22, 16 threads); budget for it
    withLabel: predict   { cpus = 16; memory = 64.GB; time = 48.h }
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        process.container = 'ghcr.io/ericmalekos/riboseq-model:latest'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        process.container = 'ghcr.io/ericmalekos/riboseq-model:latest'
    }
    cpu {
        params.device = 'cpu'
        process.container = 'ghcr.io/ericmalekos/riboseq-model:cpu'
    }
    gpu {
        params.device = 'cuda'
        process.container = 'ghcr.io/ericmalekos/riboseq-model:gpu'
        docker.runOptions      = '--gpus all -u $(id -u):$(id -g)'
        singularity.runOptions = '--nv'
        // RIBO_MAMBA_IMPL=cuda REFUSES the pure-PyTorch fallback, so a missing mamba_ssm is
        // an error instead of a silent 100x slowdown on a machine that has a GPU.
        env.RIBO_MAMBA_IMPL = 'cuda'
        process { withLabel: predict { accelerator = 1; time = 2.h } }
    }
    slurm {
        process.executor = 'slurm'
    }
    // No container: use tools already on PATH, and put this checkout's scripts there too.
    // Needs STAR, samtools, cutadapt, gffread, RiboCode, ribotish and torch installed
    // yourself; containers/Dockerfile.riboseq-model is the reference for versions.
    local {
        process.beforeScript = """
            export PATH=\"${projectDir}/scripts:${projectDir}/scripts/demo:${projectDir}/scripts/orfcallers:\$PATH\"
            export PYTHONPATH=\"${projectDir}/scripts:\${PYTHONPATH:-}\"
        """.stripIndent()
    }
    test {
        params.chrom      = 'chr22'
        params.rna_fastq  = 'fastq/SRR15513269_{1,2}.fastq.gz'
        params.ribo_fastq = 'fastq/SRR15513208.fastq.gz'
    }
}

// Nextflow 26 forbids top-level statements in the script, so the completion handler lives here.
workflow.onComplete = {
    // --help runs no processes, so claiming results were written would be false.
    if (params.help) return
    println(workflow.success
        ? "\nDone. Results in ${params.outdir}/ -- start with RESULTS.txt\n"
        : "\nFailed: ${workflow.errorMessage}\n")
}
